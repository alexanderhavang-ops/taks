[Unit]
Description=Local CPU LLM (llama.cpp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Restart=always
RestartSec=2
Environment=LLM_MODEL=/opt/llm/models/qwen2.5-0.5b-instruct-q4_k_m.gguf
ExecStart=/usr/local/bin/llama-server -m ${LLM_MODEL} --host 127.0.0.1 --port 8090 -t 2 -c 2048 --alias local-small

[Install]
WantedBy=multi-user.target
