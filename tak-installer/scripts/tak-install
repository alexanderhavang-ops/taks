#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="${ENV_FILE:-/etc/tak/install.env}"

log(){ echo "[$(date -Is)] $*"; }
die(){ echo "ERROR: $*" >&2; exit 1; }
require_root(){ [[ $EUID -eq 0 ]] || die "must run as root"; }

load_env(){
  if [[ -f "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE"
  fi

  INSTALL_MODE="${INSTALL_MODE:-online}"  # online|offline

  # Offline bundle inputs
  BUNDLE_TGZ="${BUNDLE_TGZ:-}"
  BUNDLE_DIR="${BUNDLE_DIR:-/opt/taks/offline-bundle}"

  # Online TAK deb location (provided by operator/orchestrator)
  TAK_DEB="${TAK_DEB:-/opt/tak/install/takserver_5.6-RELEASE6_all.deb}"

  # Optional
  PUBLIC_PORT_ENROLL="${PUBLIC_PORT_ENROLL:-8446}"
}

require_identity(){
  : "${BATTALION:?missing BATTALION in /etc/tak/install.env}"
  : "${BASE_DOMAIN:?missing BASE_DOMAIN in /etc/tak/install.env}"
  : "${FQDN:?missing FQDN in /etc/tak/install.env}"
  : "${LE_EMAIL:?missing LE_EMAIL in /etc/tak/install.env}"
}

pkg_install_online(){
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y
  apt-get install -y \
    ca-certificates curl jq openssl unzip \
    default-jre-headless \
    postgresql postgresql-client \
    nginx \
    xmlstarlet
}

require_offline_bundle(){
  if [[ -n "$BUNDLE_TGZ" ]]; then
    [[ -f "$BUNDLE_TGZ" ]] || die "BUNDLE_TGZ not found: $BUNDLE_TGZ"
    mkdir -p "$BUNDLE_DIR"
    log "Extracting bundle: $BUNDLE_TGZ -> $BUNDLE_DIR"
    tar -C "$BUNDLE_DIR" -xzf "$BUNDLE_TGZ"
  fi

  [[ -d "$BUNDLE_DIR/debs" ]] || die "missing bundle debs dir: $BUNDLE_DIR/debs"
  [[ -f "$BUNDLE_DIR/tak/takserver.deb" ]] || die "missing TAK deb: $BUNDLE_DIR/tak/takserver.deb"
}

offline_install_debs(){
  log "Offline installing OS deps from: $BUNDLE_DIR/debs"
  shopt -s nullglob
  local debs=( "$BUNDLE_DIR/debs"/*.deb )
  shopt -u nullglob
  [[ ${#debs[@]} -gt 0 ]] || die "no .deb files in $BUNDLE_DIR/debs"

  local pass
  for pass in 1 2 3 4 5; do
    log "dpkg pass $pass/5"
    set +e
    dpkg -i "$BUNDLE_DIR/debs"/*.deb >/tmp/tak-offline-dpkg.$pass.log 2>&1
    rc=$?
    dpkg --configure -a >>/tmp/tak-offline-dpkg.$pass.log 2>&1
    rc2=$?
    set -e

    if [[ $rc -eq 0 && $rc2 -eq 0 ]]; then
      log "dpkg converged successfully"
      return 0
    fi

    log "dpkg not yet clean (rc=$rc rc2=$rc2); continuing"
  done

  die "offline deb install did not converge after 5 passes. See /tmp/tak-offline-dpkg.*.log"
}

install_tak_deb(){
  local deb="$1"
  [[ -f "$deb" ]] || die "TAK deb not found: $deb"

  if dpkg -s takserver >/dev/null 2>&1; then
    log "TAK already installed (dpkg)."
    return 0
  fi

  log "Installing TAK deb: $deb"
  dpkg -i "$deb" || die "TAK deb install failed"
}

plan(){
  require_root
  load_env
  require_identity

  log "Plan: INSTALL_MODE=$INSTALL_MODE FQDN=$FQDN"

  case "$INSTALL_MODE" in
    offline)
      log "Would: extract bundle (if BUNDLE_TGZ set), dpkg-install debs from $BUNDLE_DIR/debs, install $BUNDLE_DIR/tak/takserver.deb"
      ;;
    online)
      log "Would: apt-get install deps, install TAK deb from $TAK_DEB"
      ;;
    *)
      die "unknown INSTALL_MODE: $INSTALL_MODE"
      ;;
  esac
}

apply(){
  require_root
  load_env
  require_identity

  case "$INSTALL_MODE" in
    offline)
      require_offline_bundle
      offline_install_debs
      install_tak_deb "$BUNDLE_DIR/tak/takserver.deb"
      ;;
    online)
      pkg_install_online
      install_tak_deb "$TAK_DEB"
      ;;
    *)
      die "unknown INSTALL_MODE: $INSTALL_MODE"
      ;;
  esac

  cert_layout_create

  log "DONE: install mechanics + cert layout complete (mode=$INSTALL_MODE)"
}

verify(){
  require_root
  load_env
  require_identity

  dpkg -s takserver >/dev/null 2>&1 || die "takserver not installed"
  log "OK: takserver package installed"
}

case "${1:-}" in
  plan) plan ;;
  apply) apply ;;
  verify) verify ;;
  *) echo "usage: tak-install {plan|apply|verify}" ; exit 2 ;;
esac

# --- filesystem layout (safe/idempotent) ---

cert_layout_create(){
  local root="/opt/tak/certs/files"

  log "Ensuring cert layout under $root"

  install -d -m 0755 "$root"
  install -d -m 0750 "$root/00_CA"
  install -d -m 0755 "$root/01_TRUST" "$root/02_SERVER" "$root/03_FEDERATION" \
                    "$root/04_USERS" "$root/05_CSRS" "$root/06_CONFIG" \
                    "$root/07_MISC" "$root/99_ARCHIVE"

  # Create empty CRL file if missing (actual content generated later)
  if [[ ! -f "$root/ca.crl" ]]; then
    install -m 0644 /dev/null "$root/ca.crl"
  fi

  # Ownership: keep conservative defaults
  # Private CA material locked down: root:root 0750
  chown -R root:root "$root/00_CA"
  chmod 0750 "$root/00_CA"

  # Everything else readable by root; later we can chgrp to 'tak' once user exists
  chown -R root:root \
    "$root/01_TRUST" "$root/02_SERVER" "$root/03_FEDERATION" \
    "$root/04_USERS" "$root/05_CSRS" "$root/06_CONFIG" \
    "$root/07_MISC" "$root/99_ARCHIVE" "$root/ca.crl" || true

  chmod 0644 "$root/ca.crl" || true
}

