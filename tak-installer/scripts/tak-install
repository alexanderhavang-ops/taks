#!/usr/bin/env bash
set -euo pipefail

# Source modules
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SELF_DIR/../lib"

# shellcheck disable=SC1091
source "$LIB_DIR/00_core.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/10_install_mechanics.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/20_cert_layout.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/30_nginx.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/40_certs.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/90_call_home.sh"
# shellcheck disable=SC1091

plan(){
  require_root
  load_env
  require_identity

  log "Plan: INSTALL_MODE=$INSTALL_MODE FQDN=$FQDN"

  case "$INSTALL_MODE" in
    offline)
      log "Would: extract bundle (if BUNDLE_TGZ set), dpkg-install debs from $BUNDLE_DIR/debs, install $BUNDLE_DIR/tak/takserver.deb"
      ;;
    online)
      log "Would: apt-get install deps, install TAK deb from $TAK_DEB"
      ;;
    *)
      die "unknown INSTALL_MODE: $INSTALL_MODE"
      ;;
  esac

  log "Would: ensure cert layout under /opt/tak/certs/files"
  log "Would: write canonical nginx vhosts (80 + $PUBLIC_PORT_ENROLL) + safe reload"
}

apply(){
  require_root
  load_env
  require_identity

  case "$INSTALL_MODE" in
    offline)
      require_offline_bundle
      offline_install_debs
      install_tak_deb "$BUNDLE_DIR/tak/takserver.deb"
      ;;
    online)
      pkg_install_online
      install_tak_deb "$TAK_DEB"
      ;;
    *)
      die "unknown INSTALL_MODE: $INSTALL_MODE"
      ;;
  esac

  cert_layout_create
  certs_prepare
  nginx_quarantine_conflicts
  write_nginx_taknode_canonical
  nginx_reload_safe

  call_home
  log "DONE: install mechanics + cert layout + nginx complete (mode=$INSTALL_MODE)"
}

verify(){
  require_root
  load_env
  require_identity

  dpkg -s takserver >/dev/null 2>&1 || die "takserver not installed"
  nginx -t >/dev/null 2>&1 || die "nginx config invalid"
  log "OK: takserver installed + nginx config valid"
}

case "${1:-}" in
  plan) plan ;;
  apply) apply ;;
  verify) verify ;;
  *) echo "usage: tak-install {plan|apply|verify}" ; exit 2 ;;
esac
