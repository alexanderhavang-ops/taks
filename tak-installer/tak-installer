#!/usr/bin/env python3
from __future__ import annotations

import sys
from pathlib import Path

# Make tak_installer importable regardless of cwd / install method.
# Works for git checkout and for an extracted tarball.
HERE = Path(__file__).resolve()
PKG_ROOT = HERE.parent  # .../tak-installer
REPO_ROOT = PKG_ROOT.parent

sys.path.insert(0, str(PKG_ROOT))
for extra in ("takctl", "martine", "orchestrator"):
    cand = REPO_ROOT / extra
    if cand.is_dir():
        sys.path.insert(0, str(cand))

from tak_installer.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
