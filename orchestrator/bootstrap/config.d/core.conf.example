# Copy to /etc/taks-bootstrap.d/config.d/core.conf before first orch-install apply

orchestrator_fqdn = master.tak-hv-sandbox.se
public_base_url = https://master.tak-hv-sandbox.se
unit_bundle_base_url = https://master.tak-hv-sandbox.se/bundles

aws_region = eu-north-1
aws_default_ami = ami-xxxxxxxxxxxxxxxxx
aws_default_vpc_id =
aws_default_subnet_id = subnet-xxxxxxxxxxxxxxxxx
aws_default_security_group_id = sg-xxxxxxxxxxxxxxxxx
aws_default_key_name =
aws_default_instance_type = t3.medium

nodes_default_node_domain = aws.tak-hv-sandbox.se
nodes_default_cert_model = letsencrypt

launch_enabled = true
launch_default_bundle_ttl = 3600

letsencrypt_mode = dns-route53
letsencrypt_email = you@example.com
letsencrypt_wildcard_zone = aws.tak-hv-sandbox.se
letsencrypt_artifact_cert_dir = /opt/tak-orch/state/artifacts/letsencrypt/aws.tak-hv-sandbox.se

bundles_source_repo_root = /opt/taks
bundles_default_bundle_kind = tak-node
bundles_include_taks_source = true

state_dir = /opt/tak-orch/state
artifacts_dir = /opt/tak-orch/state/artifacts
rendered_bundles_dir = /opt/tak-orch/state/bundles/rendered
