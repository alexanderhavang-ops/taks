[Unit]
Description=taks orchestrator backend (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/taks/orchestrator
Environment=PYTHONPATH=/opt/taks/orchestrator
ExecStart=/opt/taks/orchestrator/.venv/bin/uvicorn --app-dir /opt/taks/orchestrator orchestrator_api.app:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
