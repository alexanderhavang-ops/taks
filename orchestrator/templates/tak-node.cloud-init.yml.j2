#cloud-config
package_update: false
package_upgrade: false

write_files:
  - path: /usr/local/sbin/taks-bootstrap.sh
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      ORCH_API_URL="{{ orch_api_url }}"
      ORCH_API_USER="{{ orch_api_user }}"
      ORCH_API_PASSWORD="{{ orch_api_password }}"

      STATE_DIR="/opt/taks"
      BUNDLES_DIR="/var/lib/taks/bundles"
      WORK="${STATE_DIR}/work"

      mkdir -p "$BUNDLES_DIR" "$WORK"

      echo "== taks-bootstrap start $(date -Is) =="
      curl -fsS \
        -o "${BUNDLES_DIR}/taks_orch_bundle.tar.gz" \
        "${ORCH_API_URL}/bundles/taks_orch_bundle.tar.gz"

      rm -rf "${WORK:?}"/*
      tar -xzf "${BUNDLES_DIR}/taks_orch_bundle.tar.gz" -C "$WORK"

      # Bundle may extract under a top-level directory (e.g. taks_orch_bundle/).
      # Find install/install.sh anywhere within $WORK (maxdepth=3 to keep it tight).
      install_sh="$(find "$WORK" -maxdepth 3 -type f -path "*/install/install.sh" | head -n 1 || true)"
      if [[ -z "${install_sh:-}" || ! -f "$install_sh" ]]; then
        echo "ERROR: install/install.sh missing in bundle"
        find "$WORK" -maxdepth 3 -type f || true
        exit 3
      fi

      chmod +x "$install_sh"
      bash "$install_sh"

      echo "== taks-bootstrap done $(date -Is) =="

  - path: /usr/local/sbin/taks-node-register.sh
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      if [[ -f /etc/taks/node.env ]]; then
        set -a; source /etc/taks/node.env; set +a
      fi

      ORCH_API_URL="{{ orch_api_url }}"
      ORCH_API_USER="{{ orch_api_user }}"
      ORCH_API_PASSWORD="{{ orch_api_password }}"

      node_id="${HOSTNAME:-$(hostname)}"
      unit_path="${UNIT_PATH:-}"
      role="${ROLE:-}"
      fqdn="${FQDN:-}"

      meta() { curl -fsS --max-time 2 "http://169.254.169.254/latest/meta-data/$1" 2>/dev/null || true; }
      private_ip="$(meta local-ipv4)"
      public_ip="$(meta public-ipv4)"

      payload="$(python3 -c 'import json,sys; node_id,unit_path,role,fqdn,private_ip,public_ip=sys.argv[1:7]; print(json.dumps({"node_id":node_id,"unit_path":unit_path,"role":role,"fqdn":fqdn,"private_ip":private_ip,"public_ip":public_ip}))' \
        "$node_id" "$unit_path" "$role" "$fqdn" "$private_ip" "$public_ip")"
      curl -fsS \
        -u "${ORCH_API_USER}:${ORCH_API_PASSWORD}" \
        -H 'content-type: application/json' \
        "${ORCH_API_URL}/api/v1/nodes/register" \
        -d "$payload" >/dev/null

  - path: /usr/local/sbin/taks-node-heartbeat.sh
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      if [[ -f /etc/taks/node.env ]]; then
        set -a; source /etc/taks/node.env; set +a
      fi

      ORCH_API_URL="{{ orch_api_url }}"
      ORCH_API_USER="{{ orch_api_user }}"
      ORCH_API_PASSWORD="{{ orch_api_password }}"

      node_id="${HOSTNAME:-$(hostname)}"

      payload="$(python3 -c 'import json,sys,time; node_id=sys.argv[1]; print(json.dumps({"node_id":node_id,"ts":int(time.time())}))' "$node_id")"
      curl -fsS \
        -u "${ORCH_API_USER}:${ORCH_API_PASSWORD}" \
        -H 'content-type: application/json' \
        "${ORCH_API_URL}/api/v1/nodes/heartbeat" \
        -d "$payload" >/dev/null

  - path: /etc/systemd/system/taks-node-heartbeat.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=TAKS node heartbeat

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/taks-node-heartbeat.sh

  - path: /etc/systemd/system/taks-node-heartbeat.timer
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=TAKS node heartbeat timer

      [Timer]
      OnBootSec=30
      OnUnitActiveSec=30
      AccuracySec=5s
      Unit=taks-node-heartbeat.service

      [Install]
      WantedBy=timers.target

runcmd:
  - [ bash, -lc, "/usr/local/sbin/taks-bootstrap.sh || true" ]
  - [ bash, -lc, "/usr/local/sbin/taks-node-register.sh || true" ]
  - [ bash, -lc, "systemctl daemon-reload" ]
  - [ bash, -lc, "systemctl enable --now taks-node-heartbeat.timer" ]

