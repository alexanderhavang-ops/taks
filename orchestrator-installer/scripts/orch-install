#!/usr/bin/env bash
set -euo pipefail

export BASE_DIR="
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SELF_DIR/../lib"

# shellcheck disable=SC1091
source "$LIB_DIR/00_core.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/10_packages.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/20_orch_app.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/30_nginx_le.sh"

plan(){
  require_root
  load_env
  log "Plan for ${FQDN}: install pkgs, canonical nginx vhost, obtain LE cert, safe reload."
}

apply(){
  require_root
  load_env
  pkg_install
  orch_app_install
  install -d -m 0755 -o www-data -g www-data /var/log/tak-orch
  ensure_webroot
  nginx_quarantine_conflicts
  write_nginx_canonical
  le_cert_obtain
  nginx_reload_safe
  log "DONE: nginx + LE ready for ${FQDN}"
}

verify(){
  require_root
  load_env
  systemctl is-active --quiet nginx || die "nginx not active"
  [[ -f "/etc/letsencrypt/live/${FQDN}/fullchain.pem" ]] || die "LE cert missing for ${FQDN}"
  orch_app_verify
  curl -skI "https://${FQDN}/" | head -n 5
  log "OK: ${FQDN} responds on 443 with LE cert present"
}

case "${1:-}" in
  plan) plan ;;
  apply) apply ;;
  verify) verify ;;
  *) echo "usage: orch-install {plan|apply|verify}" ; exit 2 ;;
esac
