#!/usr/bin/env bash

export REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

set -euo pipefail

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SELF_DIR/../lib"

source "$LIB_DIR/00_core.sh"
source "$LIB_DIR/10_packages.sh"
source "$LIB_DIR/15_swap.sh"
source "$LIB_DIR/20_orch_app.sh"
source "$LIB_DIR/30_nginx_le.sh"

plan(){
  require_root
  load_env
  log "Plan for ${FQDN}: install pkgs, canonical nginx vhost, obtain LE cert, sync wildcard cert artifacts, safe reload."
}

apply(){
  require_root
  load_env
  pkg_install
  ensure_swap /swapfile 4
  orch_app_install
  orchestrator-installer/scripts/check-routes.sh
  install -d -m 0755 -o www-data -g www-data /var/log/tak-orch
  ensure_webroot
  nginx_quarantine_conflicts
  write_nginx_canonical
  le_cert_obtain
  sync_le_cert_to_artifacts
  nginx_reload_safe
  log "DONE: nginx + LE + artifact sync ready for ${FQDN}"
}

verify(){
  require_root
  load_env

  systemctl is-active --quiet nginx || die "nginx not active"
  nginx -t >/dev/null 2>&1 || die "nginx config test failed"

  [[ -f "$(le_cert_path_domain)" ]] || die "LE cert missing for $(le_domain)"

  orch_app_verify

  curl -skf "https://${FQDN}/openapi.json" >/dev/null || die "openapi.json not reachable via nginx"

  if [[ -f "$(le_cert_path_domain)" && -f "$(le_key_path_domain)" ]]; then
    [[ -f "$(artifact_tls_dir)/fullchain.pem" ]] || die "artifact fullchain missing in $(artifact_tls_dir)"
    [[ -f "$(artifact_tls_dir)/privkey.pem" ]] || die "artifact privkey missing in $(artifact_tls_dir)"
  fi

  log "OK: ${FQDN} nginx+LE+artifact sync+backend verified"
}

case "${1:-}" in
  plan) plan ;;
  apply) apply ;;
  verify) verify ;;
  *) echo "usage: orch-install {plan|apply|verify}" ; exit 2 ;;
esac
