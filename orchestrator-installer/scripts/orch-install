#!/usr/bin/env bash

export REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

set -euo pipefail

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SELF_DIR/../lib"

source "$LIB_DIR/00_core.sh"
source "$LIB_DIR/10_packages.sh"
source "$LIB_DIR/15_swap.sh"
source "$LIB_DIR/20_orch_app.sh"
source "$LIB_DIR/30_nginx_le.sh"

have_runtime_config(){
  [[ -f /opt/tak-orch/orchestrator/conf.d/core.conf ]] && [[ -f /opt/tak-orch/orchestrator/secrets.d/auth.conf ]]
}

have_bootstrap_seed(){
  find /etc/taks-bootstrap.d/config.d /etc/taks-bootstrap.d/secrets.d -maxdepth 1 -type f -name '*.conf' 2>/dev/null | grep -q .
}

require_initial_or_runtime_config(){
  if have_runtime_config; then
    return 0
  fi
  if have_bootstrap_seed; then
    return 0
  fi
  die "missing orchestrator config: need existing runtime conf.d/secrets.d or initial seed in /etc/taks-bootstrap.d/config.d and /etc/taks-bootstrap.d/secrets.d"
}

plan(){
  require_root
  log "Plan for orchestrator install: install pkgs, materialize runtime config, canonical nginx vhost, obtain LE cert, sync wildcard cert artifacts, safe reload."
}

apply(){
  require_root
  require_initial_or_runtime_config
  pkg_install
  ensure_swap /swapfile 4

  # First materialize/sync runtime app + config from source/bootstrap.
  orch_app_install

  # Runtime config now exists; only now load env-derived values like FQDN/LE.
  load_env

  orchestrator-installer/scripts/check-routes.sh
  install -d -m 0755 -o www-data -g www-data /var/log/tak-orch
  ensure_webroot
  nginx_quarantine_conflicts
  write_nginx_canonical
  le_cert_obtain
  sync_le_cert_to_artifacts
  nginx_reload_safe
  log "DONE: nginx + LE + artifact sync ready for ${FQDN}"
}

verify(){
  require_root
  require_initial_or_runtime_config
  load_env

  systemctl is-active --quiet nginx || die "nginx not active"
  nginx -t >/dev/null 2>&1 || die "nginx config test failed"

  [[ -f "$(public_cert_path)" ]] || die "LE cert missing for ${FQDN}"

  orch_app_verify

  curl -skf "https://${FQDN}/openapi.json" >/dev/null || die "openapi.json not reachable via nginx"

  if [[ -f "$(artifact_source_cert_path)" && -f "$(artifact_source_key_path)" ]]; then
    [[ -f "$(artifact_tls_dir)/fullchain.pem" ]] || die "artifact fullchain missing in $(artifact_tls_dir)"
    [[ -f "$(artifact_tls_dir)/privkey.pem" ]] || die "artifact privkey missing in $(artifact_tls_dir)"
  fi

  log "OK: ${FQDN} nginx+LE+artifact sync+backend verified"
}

case "${1:-}" in
  plan) plan ;;
  apply) apply ;;
  verify) verify ;;
  *) echo "usage: orch-install {plan|apply|verify}" ; exit 2 ;;
esac
