#!/usr/bin/env bash

# repo root (used by lib/*.sh)
export REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

set -euo pipefail

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SELF_DIR/../lib"

# shellcheck disable=SC1091
source "$LIB_DIR/00_core.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/10_packages.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/15_swap.sh"

# shellcheck disable=SC1091
source "$LIB_DIR/20_orch_app.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/30_nginx_le.sh"

plan(){
  require_root
  load_env
  log "Plan for ${FQDN}: install pkgs, canonical nginx vhost, obtain LE cert, safe reload."
}

apply(){
  require_root
  load_env
  pkg_install
  ensure_swap /swapfile 4
  orch_app_install
  orchestrator-installer/scripts/check-routes.sh
  install -d -m 0755 -o www-data -g www-data /var/log/tak-orch
  ensure_webroot
  nginx_quarantine_conflicts
  write_nginx_canonical
  le_cert_obtain
  nginx_reload_safe
  log "DONE: nginx + LE ready for ${FQDN}"
}

verify(){
  require_root
  load_env

  # nginx must be active and config-valid
  systemctl is-active --quiet nginx || die "nginx not active"
  nginx -t >/dev/null 2>&1 || die "nginx config test failed"

  # cert must exist for the public FQDN
  [[ -f "/etc/letsencrypt/live/${FQDN}/fullchain.pem" ]] || die "LE cert missing for ${FQDN}"

  # backend must be up (systemd + local healthz)
  orch_app_verify

  # prove TLS vhost routes to backend (OpenAPI must exist)
  curl -skf "https://${FQDN}/openapi.json" >/dev/null || die "openapi.json not reachable via nginx"

  log "OK: ${FQDN} nginx+LE+backend verified"
}

case "${1:-}" in
  plan) plan ;;
  apply) apply ;;
  verify) verify ;;
  *) echo "usage: orch-install {plan|apply|verify}" ; exit 2 ;;
esac
