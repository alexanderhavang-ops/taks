# --- secrets / keys / cert material (NEVER COMMIT) ---
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.csr
**/*.crl
**/*.der
**/*.p7b
**/*.p7c
**/*.pkcs12
**/00_CA/**
**/ca.*              # ca.key, ca.crt, ca.srl etc
**/truststore*.jks
**/takserver*.jks

# --- env / config that may contain secrets ---
**/install.env
**/*.env
**/.env
**/*secrets*
**/*secret*

# --- cloud-init / logs / outputs ---
**/cloud-init-output.log
**/cloud-init*.log
**/logs/**
**/*.log

# --- OS / editor junk ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# --- Python / Node / build artifacts (if/when added) ---
__pycache__/
*.pyc
node_modules/
dist/
build/

# chatpack output
chatpack/latest.md

# offline bundle artifacts (generated)
tak-installer/offline/bundle/
taks-tak-offline-bundle-*.tar.gz

# --- real ops configs (keep out of git; use *.example instead) ---
installer/env
takctl/takctl.conf
CoreConfig.xml
nginx/*.conf
*.local
*.runtime

# --- crypto / cert material (never commit) ---
*.p12
*.pfx
*.jks
*.pem
*.key
*.crt
*.cer
*.der
*.csr
*.crl
certs/
pki/

# offline bundles / large artifacts (publish via Releases, not git)
*.tar
*.tar.gz
*.tgz
taks-tak-offline-bundle-*.tar.gz
