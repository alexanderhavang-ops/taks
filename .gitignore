# ------------------------------------------------------------
# Secrets / keys / cert material (NEVER COMMIT)
# ------------------------------------------------------------
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.csr
**/*.crl
**/*.der
**/*.p7b
**/*.p7c
**/*.pkcs12

**/00_CA/**
**/ca.*                 # ca.key, ca.crt, ca.srl etc
**/truststore*.jks
**/takserver*.jks
*.crt
*.cer

# Common PKI dirs
certs/
pki/

# ------------------------------------------------------------
# Env / config that may contain secrets
# ------------------------------------------------------------
**/install.env
**/*.env
**/.env
**/*secrets*
**/*secret*

# Real ops configs (keep out of git; use *.example instead)
installer/env
takctl/takctl.conf
CoreConfig.xml
nginx/*.conf
*.local
*.runtime

# local battalion/site-specific nginx vhosts (never commit)
infra/nginx/local/

# ------------------------------------------------------------
# Logs / cloud-init / outputs
# ------------------------------------------------------------
**/cloud-init-output.log
**/cloud-init*.log
**/logs/**
**/*.log

# ------------------------------------------------------------
# OS / editor junk
# ------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# ------------------------------------------------------------
# Python / build artifacts
# ------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
.venv-*/
.mypy_cache/
.pytest_cache/

# Backups / temp
*.bak*
*.tmp

# ------------------------------------------------------------
# takctl generated/runtime junk
# ------------------------------------------------------------
# Exception: Python module named services.crl (NOT a certificate revocation list)
!takctl/takctl/services.crl

takctl/ignite/work/
takctl/backup/
takctl/secrets/
takctl/ignite/

# ------------------------------------------------------------
# chatpack output
# ------------------------------------------------------------
chatpack/latest.md

# ------------------------------------------------------------
# Offline bundles / large artifacts (publish via Releases, not git)
# ------------------------------------------------------------
tak-installer/offline/bundle/
taks-tak-offline-bundle-*.tar.gz
*.tar
*.tar.gz
*.tgz
*.iso
*.img
*.qcow2

# ------------------------------------------------------------
# Databases / archives (often local artifacts)
# ------------------------------------------------------------
*.sqlite
*.db
*.zip

