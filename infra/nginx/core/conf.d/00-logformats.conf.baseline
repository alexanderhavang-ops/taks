log_format enroll_dbg
  '[$time_local] $remote_addr $remote_user "$request" $status $body_bytes_sent '
  'rt=$request_time urt=$upstream_response_time '
  'up_addr=$upstream_addr up_status=$upstream_status '
  'host=$host sni=$ssl_server_name proto=$server_protocol '
  'tls=$ssl_protocol/$ssl_cipher';
