#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: takctl-makecert client <common-name>" >&2
  exit 2
}

if [ "${1:-}" != "client" ]; then
  usage
fi

CN="${2:-}"
if [ -z "$CN" ]; then
  usage
fi

TAKCTL_ROOT="/opt/tak/tools/takctl"
PYTHON_BIN="${TAKCTL_ROOT}/.venv/bin/python3"
if [ ! -x "${PYTHON_BIN}" ]; then
  PYTHON_BIN="$(command -v python3)"
fi

CERTS_DIR="/opt/tak/certs"
FILES_DIR="${CERTS_DIR}/files"
USER_DIR="${FILES_DIR}/04_USERS/${CN}"
PW_FILE="${USER_DIR}/.client-password"

mkdir -p "${USER_DIR}"
chmod 0700 "${USER_DIR}"

cd "${CERTS_DIR}"

eval "$(
  PYTHONPATH="${TAKCTL_ROOT}" "${PYTHON_BIN}" - <<'PY'
import shlex
from takctl.config import load_config, load_secrets

cfg = load_config()
sec = load_secrets()

vals = {
    "COUNTRY": (cfg.get("cert_country", "SE") or "SE").strip(),
    "STATE": (cfg.get("cert_state", "") or "").strip(),
    "CITY": (cfg.get("cert_city", "") or "").strip(),
    "ORGANIZATION": (cfg.get("cert_organization", "TAK") or "TAK").strip(),
    "ORGANIZATIONAL_UNIT": (cfg.get("cert_organizational_unit", "") or "").strip(),
    "CAPASS": (sec.get("cert_capass", "") or "").strip(),
}

missing = [k for k in ("STATE", "CITY", "ORGANIZATIONAL_UNIT", "CAPASS") if not vals.get(k)]
if missing:
    raise SystemExit("missing cert config/secrets: " + ", ".join(missing))

for k, v in vals.items():
    print(f"export {k}={shlex.quote(v)}")
PY
)"

if [ -f "${PW_FILE}" ]; then
  USER_PASS="$(cat "${PW_FILE}")"
else
  USER_PASS="$(openssl rand -base64 18 | tr -d '\n' | tr '/+' 'AB' | cut -c1-24)"
fi

export PASS="${USER_PASS}"

./makeCert.sh client "${CN}" --force

for ext in key csr pem p12 jks; do
  src="${FILES_DIR}/${CN}.${ext}"
  if [ -f "${src}" ]; then
    mv -f "${src}" "${USER_DIR}/${CN}.${ext}"
  fi
done

if [ -f "${FILES_DIR}/${CN}-trusted.pem" ]; then
  mv -f "${FILES_DIR}/${CN}-trusted.pem" "${USER_DIR}/${CN}-trusted.pem"
fi

printf '%s\n' "${USER_PASS}" > "${PW_FILE}"

chown -R tak:tak "${USER_DIR}" 2>/dev/null || true
chmod 0750 "${USER_DIR}" 2>/dev/null || true
chmod 0640 "${PW_FILE}" 2>/dev/null || true

chmod 0640 "${USER_DIR}/${CN}.key" 2>/dev/null || true
chmod 0640 "${USER_DIR}/${CN}.pem" "${USER_DIR}/${CN}.p12" "${USER_DIR}/${CN}.jks" "${USER_DIR}/${CN}.csr" "${USER_DIR}/${CN}-trusted.pem" 2>/dev/null || true

echo "ok: ${USER_DIR}/${CN}.pem"
