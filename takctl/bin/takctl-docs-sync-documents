#!/usr/bin/env python3
from __future__ import annotations

import json

from takctl.services.docs_ingest import import_runtime_documents


def main() -> int:
    out = import_runtime_documents(process_queue=True)
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
