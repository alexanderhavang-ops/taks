# Node DevOps HTTPS virtual host (template)
# Render NODE_FQDN and install certificates during node bootstrap.
# This vhost is independent of the public Let's Encrypt certificate.
server {
    listen 443 ssl;
    server_name devops.NODE_FQDN;

    ssl_certificate /etc/taks-devops/tls/node.crt;
    ssl_certificate_key /etc/taks-devops/tls/node.key;
    ssl_client_certificate /etc/taks-devops/tls/ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 64k;
    location = /api/orchestrator/mcp/devops {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-TAKS-Client-Verified $ssl_client_verify;
        proxy_connect_timeout 5s;
        proxy_read_timeout 25s;
    }
    location / { return 404; }
}
