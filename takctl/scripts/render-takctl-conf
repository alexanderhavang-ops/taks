#!/usr/bin/env bash
set -euo pipefail

# Renders takctl.conf from environment variables.
#
# Sources (first found wins):
#   - /etc/takctl/env
#   - /etc/tak-installer/env
#
# Output:
#   - /opt/tak/tools/takctl/takctl.conf   (default)
#
# Safe: does NOT print secrets.

ENV_FILES=(/etc/takctl/env /etc/tak-installer/env)
for f in "${ENV_FILES[@]}"; do
  if [[ -f "$f" ]]; then
    # shellcheck disable=SC1090
    source "$f"
    break
  fi
done

OUT="${TAKCTL_CONF_OUT:-/opt/tak/tools/takctl/takctl.conf}"

# Defaults (can be overridden by env)
DB_MODE="${TAKCTL_DB_MODE:-psycopg2}"
DB_NAME="${TAKCTL_DB_NAME:-cot}"
DB_HOST="${TAKCTL_DB_HOST:-127.0.0.1}"
DB_PORT="${TAKCTL_DB_PORT:-5432}"
DB_USER="${TAKCTL_DB_USER:-takctl_crl_ro}"
DB_PASSWORD="${TAKCTL_DB_PASSWORD:-}"

SUDO_USER="${TAKCTL_SUDO_USER:-postgres}"

CORECONFIG_PATH="${TAKCTL_CORECONFIG_PATH:-/opt/tak/CoreConfig.xml}"
CA_DIR="${TAKCTL_CA_DIR:-/opt/tak/certs/files/00_CA}"
CRL_PATH="${TAKCTL_CRL_PATH:-/opt/tak/certs/files/ca.crl}"

CRL_SIGN_HELPER="${TAKCTL_CRL_SIGN_HELPER:-/usr/local/sbin/takctl-crl-sign}"
CRL_SIGN_HELPER_TIMEOUT_SEC="${TAKCTL_CRL_SIGN_HELPER_TIMEOUT_SEC:-60}"

CA_SIGNING_P12="${TAKCTL_CA_SIGNING_P12:-/opt/tak/certs/files/00_CA/ca-signing.p12}"
CA_SIGNING_P12_PASS="${TAKCTL_CA_SIGNING_P12_PASS:-}"
CA_SIGNING_ALIAS="${TAKCTL_CA_SIGNING_ALIAS:-tak-ca}"

CRL_DAYS="${TAKCTL_CRL_DAYS:-30}"

TAK_SERVICE="${TAKCTL_TAK_SERVICE:-takserver}"
AUDIT_LOG="${TAKCTL_AUDIT_LOG:-/opt/tak/tools/takctl/takctl.audit.log}"

umask 077
install -d "$(dirname "$OUT")"

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

cat > "$tmp" <<EOT
[takctl]
db_mode = ${DB_MODE}

db_name = ${DB_NAME}
db_host = ${DB_HOST}
db_port = ${DB_PORT}
db_user = ${DB_USER}
db_password = ${DB_PASSWORD}

sudo_user = ${SUDO_USER}

coreconfig_path = ${CORECONFIG_PATH}
ca_dir = ${CA_DIR}
crl_path = ${CRL_PATH}

crl_sign_helper = ${CRL_SIGN_HELPER}
crl_sign_helper_timeout_sec = ${CRL_SIGN_HELPER_TIMEOUT_SEC}

ca_signing_p12 = ${CA_SIGNING_P12}
ca_signing_p12_pass = ${CA_SIGNING_P12_PASS}
ca_signing_alias = ${CA_SIGNING_ALIAS}

crl_days = ${CRL_DAYS}

tak_service = ${TAK_SERVICE}

audit_log = ${AUDIT_LOG}
EOT

mv -f "$tmp" "$OUT"
chmod 0640 "$OUT" || true

# Optional: group ownership for takctl runtime
if getent group tak >/dev/null 2>&1; then
  chgrp tak "$OUT" || true
fi
