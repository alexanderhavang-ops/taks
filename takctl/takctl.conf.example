[takctl]
# Non-secret runtime configuration for takctl.
# Secrets belong in /opt/tak/tools/takctl/secrets.conf.

# Identity
battalion =
fqdn =
hostname =

# DB access mode:
# - psql_sudo : runs "sudo -u <sudo_user> psql ..." (no password needed if local trust works)
# - psycopg2  : uses TCP connection; requires db_password in secrets.conf
db_mode = psycopg2
db_name = cot
db_host = 127.0.0.1
db_port = 5432
db_user = takctl_crl_ro
sudo_user = postgres

# TAK / cert / CRL paths
coreconfig_path = /opt/tak/CoreConfig.xml
ca_dir = /opt/tak/certs/files/00_CA
crl_path = /opt/tak/certs/files/ca.crl

crl_sign_helper = /opt/tak/tools/takctl/bin/takctl-crl-sign
crl_sign_helper_timeout_sec = 60

# CA signing keystore used for CRL generation
# This typically matches <certificateSigning> TAKServerCAConfig in CoreConfig.xml
ca_signing_p12 = /opt/tak/certs/files/00_CA/ca-signing.p12
ca_signing_alias = tak-ca

# How long CRLs should be valid (days)
crl_days = 30

tak_service = takserver

# LLM
llm_enabled = true
llm_provider = bedrock
llm_url = http://127.0.0.1:8090/v1/completions
llm_model =
llm_timeout_s = 900
llm_n_predict = 4000
llm_temperature = 0.2
llm_phase2_evidence_profile = compact
llm_phase3_mode = llm
llm_infra_dir = /opt/tak/tools/takctl/llm-infra
llm_state_dir = /opt/tak/tools/takctl/state
aws_region = eu-north-1
bedrock_model_id = eu.anthropic.claude-sonnet-4-6

# Onboarding
onboarding_card_ttl_sec = 600
onboarding_print_card_ttl_sec = 86400
onboarding_import_card_ttl_sec = 3600
onboarding_from_addr = taks-onboarding@localhost
onboarding_external_base =
onboarding_import_tmp = /tmp

# Policy
default_policy_id = hemvarnet
policy_dir =

# Logging
audit_log = /opt/tak/tools/takctl/takctl.audit.log

# Martine
martine_state_dir = /opt/tak/tools/martine/state
martine_log_level = INFO
martine_mcp_bind_host = 127.0.0.1
martine_mcp_bind_port = 8765
martine_cot_udp_host = 127.0.0.1
martine_cot_udp_port = 6969
martine_cot_listen_host = 0.0.0.0
martine_cot_listen_port = 6970
martine_callsign = Martine
