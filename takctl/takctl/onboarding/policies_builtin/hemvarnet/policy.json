{
  "id": "hemvarnet",
  "name": "Hemvärnet (SE)",
  "version": "0.3",
  "identity_fields": [
    {
      "key": "battalion",
      "label": "Battalion",
      "type": "text",
      "required": true,
      "default": "46"
    },
    {
      "key": "battalion_fal",
      "label": "FALA Battalion",
      "type": "text",
      "required": false,
      "default": "VQ"
    },
    {
      "key": "company",
      "label": "Company",
      "type": "text",
      "required": true,
      "default": "Q"
    },
    {
      "key": "platoon",
      "label": "Platoon",
      "type": "text",
      "required": true,
      "default": "A"
    },
    {
      "key": "group",
      "label": "Group",
      "type": "select",
      "required": true,
      "default": "E",
      "options": [
        "E",
        "F",
        "G",
        "H"
      ]
    },
    {
      "key": "n",
      "label": "Number",
      "type": "text",
      "required": true,
      "default": "1"
    },
    {
      "key": "team",
      "label": "Team color",
      "type": "select",
      "required": true,
      "default": "Blue",
      "options": [
        "Black",
        "White",
        "Orange",
        "Magenta",
        "Cyan",
        "Purple",
        "Blue",
        "Maroon",
        "Green",
        "Yellow",
        "Red"
      ]
    },
    {
      "key": "atak_role_type",
      "label": "ATAK Role (My Role)",
      "type": "select",
      "required": true,
      "default": "Soldier",
      "options": [
        "Soldier",
        "Team Lead"
      ]
    },
    {
      "key": "remarks",
      "label": "Remarks",
      "type": "text",
      "required": false,
      "default": "#soldat"
    }
  ],
  "group_fields": [
    {
      "key": "groups_rw",
      "label": "Groups (RW)",
      "type": "csv",
      "default": "46hvbat"
    },
    {
      "key": "groups_in",
      "label": "In groups (send only)",
      "type": "csv",
      "default": ""
    },
    {
      "key": "groups_out",
      "label": "Out groups (read only)",
      "type": "csv",
      "default": ""
    }
  ],
  "config_fields": [
    {
      "key": "coord_system",
      "label": "Coordinate system",
      "type": "select",
      "default": "MGRS",
      "options": [
        "MGRS",
        "LatLon"
      ]
    },
    {
      "key": "units",
      "label": "Units",
      "type": "select",
      "default": "metric",
      "options": [
        "metric",
        "imperial"
      ]
    },
    {
      "key": "allow_callsign_change",
      "label": "Allow callsign change",
      "type": "bool",
      "default": false
    },
    {
      "key": "coord_display",
      "label": "Coordinate Display",
      "type": "select",
      "default": "MGRS",
      "options": [
        "MGRS",
        "DD",
        "DMS",
        "UTM"
      ]
    },
    {
      "key": "alt_display",
      "label": "Altitude Display",
      "type": "select",
      "default": "MSL",
      "options": [
        "MSL",
        "HAE"
      ]
    },
    {
      "key": "alt_units",
      "label": "Altitude Units",
      "type": "select",
      "default": "Meters",
      "options": [
        "Meters",
        "Feet"
      ]
    },
    {
      "key": "speed_units",
      "label": "Speed Units",
      "type": "select",
      "default": "km/h",
      "options": [
        "km/h",
        "m/s",
        "mph",
        "knots"
      ]
    },
    {
      "key": "compass_heading_display",
      "label": "Compass Heading Display",
      "type": "select",
      "default": "Numeric",
      "options": [
        "Numeric",
        "Cardinal"
      ]
    },
    {
      "key": "bearing_units",
      "label": "Bearing Units",
      "type": "select",
      "default": "Mils",
      "options": [
        "Mils",
        "Degrees"
      ]
    },
    {
      "key": "range_units",
      "label": "Range Units",
      "type": "select",
      "default": "Meters/kilometers",
      "options": [
        "Meters/kilometers",
        "Feet/miles",
        "Nautical"
      ]
    },
    {
      "key": "north_ref",
      "label": "North Reference",
      "type": "select",
      "default": "Grid North",
      "options": [
        "Grid North",
        "True North",
        "Magnetic North"
      ]
    },
    {
      "key": "domain_pref",
      "label": "Set Domain Preference",
      "type": "select",
      "default": "Ground",
      "options": [
        "Ground",
        "Air",
        "Sea",
        "Space"
      ]
    }
  ],
  "defaults": {
    "coord_system": "MGRS",
    "units": "metric",
    "allow_callsign_change": false
  },
  "notes": "Doc is shipped as doc.pdf next to this file (replaceable at runtime via /opt/tak/takctl-state/policies.d).",
  "maps": {
    "battalion_to_fal": {
      "46": "VQ",
      "48": "VW"
    },
    "fal_to_battalion": {
      "VQ": "46",
      "VW": "48"
    }
  },
  "title": "Hemvärnet",
  "sections": {
    "identity": {
      "title": "Identity",
      "help": "Unit identity + callsign conventions + group membership."
    },
    "config": {
      "title": "Configuration",
      "help": "ATAK baseline settings for interoperability (display units, MGRS, etc)."
    }
  },
  "config_defaults": {
    "coordinate_display": "MGRS",
    "altitude_display": "MSL",
    "altitude_units": "Meters",
    "speed_units": "km/h",
    "compass_heading": "Numeric",
    "bearing_units": "Mils",
    "range_units": "Meters/kilometers",
    "north_reference": "Grid North",
    "domain_preference": "Ground"
  },
  "policy_id": "hemvarnet",
