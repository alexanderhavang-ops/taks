{
  "id": "hemvarnet",
  "name": "Hemvärnet (SE)",
  "version": "0.3",
  "identity_fields": [
    {
      "key": "battalion",
      "label": "Battalion",
      "type": "text",
      "required": true,
      "default": "46"
    },
    {
      "key": "battalion_fal",
      "label": "FALA Battalion",
      "type": "text",
      "required": true,
      "default": "VQ"
    },
    {
      "key": "company",
      "label": "Company",
      "type": "text",
      "required": true,
      "default": "Q"
    },
    {
      "key": "platoon",
      "label": "Platoon",
      "type": "text",
      "required": true,
      "default": "A"
    },
    {
      "key": "group",
      "label": "Group",
      "type": "select",
      "required": true,
      "default": "1",
      "options": ["1", "2", "3", "4"]
    },
    {
      "key": "n",
      "label": "Number",
      "type": "text",
      "required": true,
      "default": "1"
    },
    {
      "key": "team_color",
      "label": "Team color",
      "type": "select",
      "required": true,
      "default": "Blue",
      "options": ["Black","White","Orange","Magenta","Cyan","Purple","Blue","Maroon","Green","Yellow","Red"]
    },
    {
      "key": "atak_role_type",
      "label": "ATAK Role (My Role)",
      "type": "select",
      "required": true,
      "default": "Soldier",
      "options": ["Soldier", "Team Lead"]
    },
    {
      "key": "remarks",
      "label": "Remarks",
      "type": "text",
      "required": false,
      "default": "#soldat"
    },
    {
      "key": "callsign",
      "label": "Callsign",
      "type": "text",
      "required": false,
      "readonly": false,
      "default": ""
    }
  ],
  "group_fields": [
    {
      "key": "groups_rw",
      "label": "Groups (RW)",
      "type": "csv",
      "default": "46hvbat"
    },
    {
      "key": "groups_in",
      "label": "In groups (send only)",
      "type": "csv",
      "default": ""
    },
    {
      "key": "groups_out",
      "label": "Out groups (read only)",
      "type": "csv",
      "default": ""
    }
  ],
  "config_fields": [
    {
      "key": "coord_system",
      "label": "Coordinate system",
      "type": "select",
      "default": "MGRS",
      "options": ["MGRS", "LatLon"]
    },
    {
      "key": "units",
      "label": "Units",
      "type": "select",
      "default": "metric",
      "options": ["metric", "imperial"]
    },
    {
      "key": "allow_callsign_change",
      "label": "Allow callsign change",
      "type": "bool",
      "default": false
    }
  ],
  "defaults": {
    "coord_system": "MGRS",
    "units": "metric",
    "allow_callsign_change": false
  },
  "notes": "Doc is shipped as doc.pdf next to this file (replaceable at runtime via /opt/tak/takctl-state/policies.d)."
}
