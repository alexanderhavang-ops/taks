# onboarding identity + package policy

# Main onboarding mode:
#   auto-enroll   = ATAK enrolls with username/password
#   cert-creation = TAKS creates client certs/packages
onboarding_mode = cert-creation

# Backward-compatibility legacy flag. Prefer onboarding_mode.
# If true, creating a TAK user through onboarding also creates a client cert
# with the same username/CN and binds it to the user via fingerprint.
create_cert_with_user = true

# If true, cert-based packages may include the client cert password.
include_client_password_in_package = false

# If true, cert-based packages may include the truststore password.
include_truststore_password_in_package = false

# If true, show truststore password on the soldier card when it is NOT embedded
# in the package and the active onboarding mode needs it.
reveal_truststore_password_on_soldier_card = false

# If true, show client certificate password on the soldier card when it is NOT
# embedded in the package and the active onboarding mode needs it.
reveal_client_password_on_soldier_card = false

# Default for showing the TAK user password on the soldier card.
# Actual rendering still depends on TAKS knowing the password.
reveal_password_default = true
