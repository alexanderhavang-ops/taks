martine_state_dir = /opt/tak/tools/martine/state
martine_trace_dir = /opt/tak/tools/martine/state/logs
martine_log_level = INFO
martine_mcp_bind_host = 127.0.0.1
martine_mcp_bind_port = 8765
martine_default_max_turns = 6
martine_default_max_tool_calls = 10
martine_default_max_output_tokens = 2000
martine_default_allow_repair_turn = true
martine.client.martine_chat.max_turns = 6
martine.client.martine_chat.max_tool_calls = 10
martine.client.llm3.max_turns = 8
martine.client.llm3.max_tool_calls = 12
martine.client.llm3.timeline.phase2.max_output_tokens = 8000
martine.client.replay.max_turns = 4
martine.client.replay.max_tool_calls = 6
martine.client.llm3.timeline.phase3.detail.max_output_tokens = 8000
martine.client.llm3.timeline.phase3.card.max_output_tokens = 4000
martine.client.llm3.weather.phase3.detail.max_output_tokens = 6000
martine.client.llm3.weather.phase3.card.max_output_tokens = 4000

# OpenAI Agents SDK runtime (openai | local).
# OpenAI key: OPENAI_API_KEY or private takctl/secrets.d/martine.conf
# field martine_openai_api_key. Never store API keys in conf.d.
martine_agent_provider = openai
martine_agent_model = gpt-5-mini
# Local provider must offer an OpenAI-compatible Chat Completions endpoint.
martine_agent_base_url = http://127.0.0.1:11434/v1
