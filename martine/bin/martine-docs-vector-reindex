#!/usr/bin/env python3
from __future__ import annotations

import json
from martine.tools.docs_ref import list_reference_docs
from martine.tools.docs_vectors import build_doc_vector_index

def main() -> int:
    docs = list_reference_docs()
    items = list(docs.get("items") or [])
    done = 0
    for it in items:
        doc_id = str(it.get("doc_id") or "").strip()
        if not doc_id:
            continue
        r = build_doc_vector_index(doc_id)
        print(json.dumps(r, ensure_ascii=False))
        if r.get("ok"):
            done += 1
    print(f"indexed={done}")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
