#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

ts="$(date -Is)"
rev="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"

print_file(){
  local path="$1"
  echo
  echo "## FILE: $path"
  if [[ -f "$path" ]]; then
    echo '```'
    cat "$path"
    echo '```'
  else
    echo "_(missing)_"
  fi
}

redact(){
  sed -E \
    -e 's/(AWS_SECRET_ACCESS_KEY|aws_secret_access_key)[[:space:]]*=[[:space:]]*.*/\1=REDACTED/gI' \
    -e 's/(AWS_ACCESS_KEY_ID|aws_access_key_id)[[:space:]]*=[[:space:]]*.*/\1=REDACTED/gI' \
    -e 's/([Pp]assword|PASS|passphrase)[[:space:]]*=[[:space:]]*.*/\1=REDACTED/g' \
    -e 's/(Authorization:[[:space:]]*Bearer)[[:space:]]+[A-Za-z0-9\._-]+/\1 REDACTED/g'
}

{
  echo "# TAKS Chatpack"
  echo
  echo "- Generated: $ts"
  echo "- Repo: $(basename "$ROOT")"
  echo "- Branch: $branch"
  echo "- Revision: $rev"
  echo
  echo "## Intent"
  echo "Paste this into a fresh ChatGPT chat to continue work with full context."
  echo
  echo "## Quick status"
  echo '```'
  git status -sb || true
  echo '```'
  echo
  echo "## Recent commits"
  echo '```'
  git --no-pager log -n 20 --oneline || true
  echo '```'
  echo
  echo "## Repo tree (top-level, first 200 files)"
  echo '```'
  (find . -maxdepth 2 -type f | sed 's|^\./||' | sort) | head -n 200
  echo '```'
  echo

  echo "# Architecture / Notes"
  print_file "orchestrator-installer/docs/README.md"
  print_file "tak-installer/offline/README.md"

  echo
  echo "# Orchestrator installer"
  print_file "orchestrator-installer/scripts/orch-install"
  for f in orchestrator-installer/lib/*.sh; do
    print_file "$f"
  done
  for f in orchestrator-installer/cloud-init/*.yaml; do
    print_file "$f"
  done
  for f in orchestrator-installer/systemd/*; do
    print_file "$f"
  done

  echo
  echo "# TAK node installer"
  print_file "tak-installer/scripts/tak-install"
  for f in tak-installer/lib/*.sh; do
    print_file "$f"
  done
  for f in tak-installer/cloud-init/*.yaml; do
    print_file "$f"
  done
  print_file "tak-installer/offline/apt-packages.txt"
  for f in tak-installer/offline/manifests/*.txt; do
    print_file "$f"
  done

  echo
  echo "# Operator commands / runbooks (optional)"
  print_file "docs/README.md"
} | redact

